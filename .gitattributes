# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.dax text eol=lf
*.txt text eol=lf
*.json text eol=lf
Makefile text eol=lf

# Explicit binary files (do not touch line endings)
*.pbix binary
*.png binary
*.jpg binary
*.pdf binary